<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tiny LLM — Learn How a Language Model Thinks</title>
<style>
/* ============ TOKENS ============ */
:root{
  --bg:#070b12; --bg2:#0a101b;
  --card:rgba(148,170,200,.045);
  --card2:rgba(148,170,200,.08);
  --border:rgba(148,170,200,.14);
  --border2:rgba(148,170,200,.24);
  --text:#e7edf5; --muted:#8fa0b5; --faint:#5c6b80;
  --accent:#5eead4; --accent2:#7dd3fc;
  --amber:#fbbf24; --green:#34d399; --red:#f87171; --violet:#a78bfa;
  --mono:ui-monospace,"SF Mono","Cascadia Code",Menlo,Consolas,monospace;
  --sans:-apple-system,BlinkMacSystemFont,"Segoe UI",Inter,Roboto,"Helvetica Neue",Arial,sans-serif;
  --r:16px;
}
[data-theme="light"]{
  --bg:#f4f6fa; --bg2:#eceff5;
  --card:rgba(15,30,55,.04); --card2:rgba(15,30,55,.07);
  --border:rgba(15,30,55,.12); --border2:rgba(15,30,55,.22);
  --text:#111a26; --muted:#4a5a70; --faint:#7b8aa0;
  --accent:#0d9488; --accent2:#0369a1;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  font-family:var(--sans); background:var(--bg); color:var(--text);
  min-height:100vh; line-height:1.55; font-size:15px;
  background-image:
    radial-gradient(1100px 500px at 80% -10%, rgba(94,234,212,.06), transparent 60%),
    radial-gradient(900px 500px at -10% 20%, rgba(125,211,252,.05), transparent 60%),
    linear-gradient(rgba(148,170,200,.033) 1px, transparent 1px),
    linear-gradient(90deg, rgba(148,170,200,.033) 1px, transparent 1px);
  background-size:auto,auto,44px 44px,44px 44px;
}
::selection{background:rgba(94,234,212,.25)}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit}
button:focus-visible,a:focus-visible,input:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:6px}
h1,h2,h3,h4{line-height:1.25;letter-spacing:-.01em}
.mono{font-family:var(--mono);font-feature-settings:"tnum"}

/* ============ HEADER ============ */
header{
  position:sticky;top:0;z-index:60;
  display:flex;align-items:center;gap:14px;flex-wrap:wrap;
  padding:10px 20px;
  background:color-mix(in srgb, var(--bg) 82%, transparent);
  backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
  border-bottom:1px solid var(--border);
}
.brand{display:flex;align-items:center;gap:10px;min-width:0}
.logo{width:34px;height:34px;border-radius:10px;flex:none;
  background:linear-gradient(135deg,rgba(94,234,212,.22),rgba(125,211,252,.12));
  border:1px solid var(--border2);display:grid;place-items:center;color:var(--accent)}
.brand b{font-size:15px;letter-spacing:.14em}
.brand small{display:block;color:var(--muted);font-size:11px;letter-spacing:.02em;max-width:300px;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.head-mid{display:flex;align-items:center;gap:10px;margin-left:auto;flex-wrap:wrap}
.chip{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;
  border:1px solid var(--border);background:var(--card);font-size:11px;letter-spacing:.08em;color:var(--muted)}
.chip .dot{width:7px;height:7px;border-radius:50%;background:var(--faint)}
.chip.cur .dot{background:var(--accent);box-shadow:0 0 8px var(--accent)}
.chip.done .dot{background:var(--green)}
.chip.review .dot{background:var(--amber)}
.ringwrap{position:relative;width:38px;height:38px;flex:none}
.ringwrap svg{transform:rotate(-90deg)}
.ringwrap span{position:absolute;inset:0;display:grid;place-items:center;font-size:9px;font-family:var(--mono);color:var(--muted)}
.iconbtn{width:34px;height:34px;border-radius:10px;border:1px solid var(--border);background:var(--card);
  display:grid;place-items:center;color:var(--muted);transition:.18s}
.iconbtn:hover{color:var(--text);border-color:var(--border2);transform:translateY(-1px)}
.iconbtn.on{color:var(--accent);border-color:rgba(94,234,212,.4)}
.btn{padding:8px 14px;border-radius:10px;border:1px solid var(--border2);background:var(--card2);
  color:var(--text);font-size:13px;font-weight:600;letter-spacing:.02em;transition:.18s;display:inline-flex;align-items:center;gap:7px}
.btn:hover{border-color:var(--accent);color:var(--accent);transform:translateY(-1px)}
.btn.primary{background:linear-gradient(135deg,rgba(94,234,212,.18),rgba(125,211,252,.10));
  border-color:rgba(94,234,212,.45);color:var(--accent)}
.btn.ghost{background:transparent}
.btn.danger:hover{border-color:var(--red);color:var(--red)}
.btn.sm{padding:5px 10px;font-size:12px;border-radius:8px}

/* ============ MASTER MAP ============ */
#mapbar{position:sticky;top:55px;z-index:50;padding:10px 20px;border-bottom:1px solid var(--border);
  background:color-mix(in srgb, var(--bg) 78%, transparent);backdrop-filter:blur(12px)}
#mapbar .mapscroll{display:flex;align-items:center;gap:6px;overflow-x:auto;padding-bottom:2px;scrollbar-width:thin}
.mapnode{flex:none;display:flex;flex-direction:column;align-items:center;gap:4px;padding:7px 11px;border-radius:11px;
  border:1px solid var(--border);background:var(--card);transition:.18s;min-width:74px}
.mapnode .lbl{font-size:10px;letter-spacing:.1em;color:var(--muted);font-weight:700}
.mapnode .st{font-size:9px;color:var(--faint);font-family:var(--mono)}
.mapnode:hover{border-color:var(--border2);transform:translateY(-2px)}
.mapnode.done{border-color:rgba(52,211,153,.35)}
.mapnode.done .st{color:var(--green)}
.mapnode.cur{border-color:rgba(94,234,212,.55);box-shadow:0 0 0 1px rgba(94,234,212,.25),0 0 18px rgba(94,234,212,.12)}
.mapnode.cur .lbl{color:var(--accent)}
.maparrow{flex:none;color:var(--faint);font-size:12px;animation:pulse 2.4s ease-in-out infinite}
@keyframes pulse{0%,100%{opacity:.35}50%{opacity:.9}}

/* ============ LAYOUT ============ */
main{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:18px;padding:18px 20px 60px;max-width:1440px;margin:0 auto}
#rail{display:flex;flex-direction:column;gap:14px}
.panel{background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:16px;
  backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px)}
.panel h3{font-size:11px;letter-spacing:.16em;color:var(--muted);margin-bottom:12px;display:flex;align-items:center;gap:8px}
.panel h3 svg{color:var(--accent)}
@media(max-width:1080px){main{grid-template-columns:1fr}}

/* ============ CARD ============ */
#cardwrap{min-width:0}
.card{background:linear-gradient(180deg,rgba(148,170,200,.07),rgba(148,170,200,.03));
  border:1px solid var(--border2);border-radius:20px;padding:26px 28px;
  box-shadow:0 20px 60px rgba(0,0,0,.35);animation:cardin .35s ease both}
@keyframes cardin{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.card .meta{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:10px}
.stepno{font-family:var(--mono);font-size:11px;color:var(--accent);letter-spacing:.14em}
.card h2{font-size:clamp(22px,3vw,30px);margin-bottom:8px}
.purpose{font-size:15.5px;color:var(--text);max-width:640px}
.purpose b{color:var(--accent2)}
.chain{display:grid;grid-template-columns:1fr auto 1fr;gap:10px;margin:18px 0;align-items:stretch}
.chain .c{border:1px solid var(--border);border-radius:12px;padding:10px 12px;font-size:12px;color:var(--muted);background:var(--card)}
.chain .c b{display:block;font-size:10px;letter-spacing:.14em;margin-bottom:3px;color:var(--faint)}
.chain .c.prev:hover,.chain .c.next:hover{border-color:var(--border2);color:var(--text);cursor:pointer}
.chain .c.now{border-color:rgba(94,234,212,.4);background:rgba(94,234,212,.06)}
.chain .c.now b{color:var(--accent)}
@media(max-width:640px){.chain{grid-template-columns:1fr}}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px}
@media(max-width:720px){.grid2{grid-template-columns:1fr}}
.block{background:var(--card);border:1px solid var(--border);border-radius:13px;padding:13px 15px}
.block h4{font-size:10px;letter-spacing:.16em;color:var(--muted);margin-bottom:6px}
.block p{font-size:13.5px;color:var(--text)}
.io{display:grid;grid-template-columns:1fr 1.15fr 1fr;gap:12px;margin-bottom:14px}
@media(max-width:720px){.io{grid-template-columns:1fr}}
.io-col{background:var(--card);border:1px solid var(--border);border-radius:13px;padding:13px 15px}
.io-col h4{font-size:10px;letter-spacing:.16em;color:var(--muted);margin-bottom:8px}
.io-col.proc{border-color:rgba(125,211,252,.3);background:rgba(125,211,252,.05)}
.io-col p,.io-col li{font-size:13px;color:var(--text)}
.io-col ul{list-style:none}
.io-col li{padding:2px 0}
.flow{display:flex;flex-direction:column;align-items:center;gap:2px;margin:6px 0 14px;padding:14px;border-radius:13px;
  border:1px dashed var(--border2);background:rgba(0,0,0,.12)}
[data-theme="light"] .flow{background:rgba(15,30,55,.04)}
.frow{display:flex;flex-direction:column;align-items:center;gap:2px}
.frow .fl{font-size:9px;letter-spacing:.18em;color:var(--faint)}
.frow .fv{font-family:var(--mono);font-size:15px;color:var(--accent2)}
.frow .fv.neg{color:var(--red)}
.frow .fv.pos{color:var(--green)}
.fop{color:var(--faint);font-size:14px;line-height:1.1}
.farrow{color:var(--accent);font-size:13px;line-height:1.4}
.mathbox{margin-bottom:14px;border:1px solid rgba(167,139,250,.3);background:rgba(167,139,250,.06);border-radius:13px;padding:14px 16px}
.mathbox h4{font-size:10px;letter-spacing:.16em;color:var(--violet);margin-bottom:8px}
.eq{font-family:var(--mono);font-size:clamp(14px,2.2vw,18px);color:var(--text);overflow-x:auto;padding:4px 0}
.eq sub,.eq sup{font-size:.65em}
.mathbox .mlabel{font-size:12px;color:var(--muted);margin-top:6px}
.eli5{margin-bottom:14px;border-left:3px solid var(--amber);background:rgba(251,191,36,.06);border-radius:0 13px 13px 0;padding:12px 16px}
.eli5 h4{font-size:10px;letter-spacing:.16em;color:var(--amber);margin-bottom:6px}
.eli5 p{font-size:13.5px}
.tech{margin-bottom:14px;border-left:3px solid var(--accent2);background:rgba(125,211,252,.05);border-radius:0 13px 13px 0;padding:12px 16px}
.tech h4{font-size:10px;letter-spacing:.16em;color:var(--accent2);margin-bottom:6px}
.tech p{font-size:13.5px}
.remember{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}
.rtag{display:inline-flex;align-items:center;gap:7px;padding:6px 12px;border-radius:999px;border:1px solid var(--border2);
  background:var(--card2);font-size:12.5px}
.rtag::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--accent);flex:none}
/* term buttons */
.term{border-bottom:1px dotted var(--accent);color:var(--accent);font-size:inherit;padding:0 1px;transition:.15s}
.term:hover{background:rgba(94,234,212,.12);border-radius:3px}
/* card controls */
.controls{display:flex;align-items:center;gap:8px;flex-wrap:wrap;border-top:1px solid var(--border);padding-top:16px}
.controls .spacer{flex:1}
.modebtn{font-size:11px;letter-spacing:.1em;padding:7px 12px;border-radius:9px;border:1px solid var(--border);color:var(--muted);transition:.15s}
.modebtn:hover{color:var(--text);border-color:var(--border2)}
.modebtn.on{color:var(--accent);border-color:rgba(94,234,212,.5);background:rgba(94,234,212,.08)}
.audiobar{display:none;align-items:center;gap:8px;margin-top:12px;padding:10px 12px;border-radius:11px;border:1px solid rgba(94,234,212,.3);background:rgba(94,234,212,.05);flex-wrap:wrap}
.audiobar.show{display:flex}
.audiobar .ab-lbl{font-size:10px;letter-spacing:.16em;color:var(--accent);margin-right:4px}
.speedbtn{font-family:var(--mono);font-size:11px;padding:4px 8px;border-radius:7px;border:1px solid var(--border);color:var(--muted)}
.speedbtn.on{color:var(--accent);border-color:rgba(94,234,212,.5)}
/* quiz */
.quizq{border:1px solid var(--border);border-radius:13px;padding:14px 16px;margin-bottom:12px;background:var(--card)}
.quizq .q{font-size:14.5px;font-weight:600;margin-bottom:8px}
.quizq .a{display:none;margin-top:8px;font-size:13.5px;color:var(--green);border-top:1px dashed var(--border);padding-top:8px}
.quizq.open .a{display:block}
.modehead{font-size:10px;letter-spacing:.18em;color:var(--accent);margin-bottom:12px;display:flex;align-items:center;gap:8px}
.revbox{border:1px solid rgba(251,191,36,.35);background:rgba(251,191,36,.05);border-radius:13px;padding:16px;margin-bottom:12px}
.memgrid{display:grid;gap:10px}
.memgrid .mg{border:1px solid var(--border);border-radius:12px;padding:12px 14px;background:var(--card)}
.memgrid .mg h5{font-size:9px;letter-spacing:.18em;color:var(--muted);margin-bottom:5px}
.memgrid .mg p{font-size:13.5px}
.memgrid .mg .eq{font-size:14px}
/* final */
.jchain{display:flex;flex-wrap:wrap;gap:8px;align-items:center;justify-content:center;margin:18px 0}
.jchip{padding:8px 13px;border-radius:10px;border:1px solid rgba(94,234,212,.35);background:rgba(94,234,212,.07);font-size:12px;letter-spacing:.06em}
.jarrow{color:var(--accent)}

/* ============ RAIL PANELS ============ */
.dimrow{display:flex;justify-content:space-between;align-items:baseline;padding:6px 0;border-bottom:1px dashed var(--border);font-size:13px}
.dimrow:last-of-type{border-bottom:none}
.dimrow b{font-family:var(--mono);color:var(--accent2);font-size:13px}
.dimwhy{font-size:12px;color:var(--muted);margin-top:10px}
.sent{font-family:var(--mono);font-size:11.5px;color:var(--muted);margin-top:8px;line-height:1.8}
.sent b{color:var(--accent)}
#nnwrap svg{width:100%;height:auto;display:block}
.nnode{fill:var(--bg2);stroke:var(--border2);stroke-width:1.2;transition:.15s}
.nnode:hover{stroke:var(--accent)}
.nnode.active{stroke:var(--accent);filter:drop-shadow(0 0 6px rgba(94,234,212,.55))}
.nlink{stroke:rgba(148,170,200,.16);stroke-width:1;transition:.15s}
.nlink:hover{stroke:var(--accent2);stroke-width:1.6}
.nlink.live{stroke:rgba(94,234,212,.4);stroke-dasharray:3 5;animation:dashmove 1.6s linear infinite}
@keyframes dashmove{to{stroke-dashoffset:-16}}
.nlabel{font-family:var(--mono);font-size:8px;fill:var(--muted)}
.nvalue{font-family:var(--mono);font-size:7.5px;fill:var(--accent2)}
#nntip{position:fixed;z-index:90;pointer-events:none;background:var(--bg2);border:1px solid var(--border2);border-radius:10px;
  padding:8px 11px;font-size:12px;box-shadow:0 10px 30px rgba(0,0,0,.4);display:none;max-width:260px}
#nntip .tt{font-size:9px;letter-spacing:.14em;color:var(--accent);margin-bottom:3px}
#chartwrap svg{width:100%;height:auto}
.legend{font-size:11px;color:var(--muted);display:flex;gap:14px;margin-top:8px;flex-wrap:wrap}
.legend i{display:inline-block;width:14px;height:3px;border-radius:2px;vertical-align:middle;margin-right:5px}
.deltagrid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}
.delta{border:1px solid var(--border);border-radius:10px;padding:8px 10px;font-size:11px;color:var(--muted)}
.delta b{display:block;font-family:var(--mono);font-size:13px;color:var(--green)}
.caveat{font-size:11px;color:var(--amber);margin-top:10px;border-top:1px dashed var(--border);padding-top:8px}
/* loop */
.loop{display:flex;flex-direction:column;gap:0}
.loopnode{display:flex;align-items:center;gap:10px;padding:7px 10px;border-radius:10px;border:1px solid var(--border);font-size:11px;letter-spacing:.1em;font-weight:700;color:var(--muted);background:var(--card)}
.loopnode.hot{color:var(--accent);border-color:rgba(94,234,212,.5);box-shadow:0 0 14px rgba(94,234,212,.12)}
.looparrow{color:var(--faint);text-align:center;font-size:11px;line-height:1.5}

/* ============ OVERLAYS ============ */
.overlay{position:fixed;inset:0;z-index:100;display:none;align-items:center;justify-content:center;padding:20px;
  background:rgba(4,7,12,.72);backdrop-filter:blur(10px)}
.overlay.show{display:flex}
.sheet{background:linear-gradient(180deg,rgba(148,170,200,.09),rgba(148,170,200,.04));
  border:1px solid var(--border2);border-radius:22px;max-width:860px;width:100%;max-height:86vh;overflow:auto;padding:30px;
  animation:cardin .3s ease both;box-shadow:0 30px 90px rgba(0,0,0,.5)}
.sheet h2{font-size:22px;margin-bottom:4px}
.sheet .sub{color:var(--muted);font-size:13px;margin-bottom:20px}
.wel-hero{text-align:center;padding:30px 10px}
.wel-hero .logo{width:64px;height:64px;border-radius:18px;margin:0 auto 18px}
.wel-hero h1{font-size:clamp(30px,6vw,46px);letter-spacing:.2em;margin-bottom:8px}
.wel-hero h1 span{color:var(--accent)}
.wel-hero .tag{color:var(--muted);font-size:15px;margin-bottom:26px}
.welstats{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-bottom:30px}
.wstat{border:1px solid var(--border2);border-radius:14px;padding:14px 22px;background:var(--card)}
.wstat b{display:block;font-family:var(--mono);font-size:22px;color:var(--accent)}
.wstat span{font-size:10px;letter-spacing:.16em;color:var(--muted)}
/* memory map */
.memchap{margin-bottom:16px;border:1px solid var(--border);border-radius:14px;padding:14px 16px;background:var(--card)}
.memchap h4{font-size:12px;letter-spacing:.14em;color:var(--accent);margin-bottom:2px}
.memchap .mm{color:var(--muted);font-size:12px;margin-bottom:10px}
.memsteps{display:flex;flex-wrap:wrap;gap:6px}
.mstep{font-family:var(--mono);font-size:10.5px;padding:5px 9px;border-radius:8px;border:1px solid var(--border);color:var(--muted);transition:.15s}
.mstep:hover{border-color:var(--accent);color:var(--accent)}
.mstep.done{border-color:rgba(52,211,153,.4);color:var(--green)}
/* search */
#searchinput{width:100%;padding:12px 16px;border-radius:12px;border:1px solid var(--border2);background:var(--card);
  color:var(--text);font-size:15px;margin-bottom:14px;font-family:inherit}
.sres{display:flex;align-items:center;gap:12px;padding:11px 13px;border-radius:11px;border:1px solid var(--border);margin-bottom:8px;transition:.15s;text-align:left;width:100%}
.sres:hover{border-color:var(--accent)}
.sres .sn{font-family:var(--mono);font-size:10px;color:var(--accent);flex:none;width:34px}
.sres .st{font-size:13.5px}
.sres .sx{font-size:11px;color:var(--muted);margin-top:2px}
/* shortcuts table */
.scuts{display:grid;grid-template-columns:1fr 1fr;gap:8px}
@media(max-width:560px){.scuts{grid-template-columns:1fr}}
.scut{display:flex;align-items:center;gap:10px;border:1px solid var(--border);border-radius:10px;padding:9px 12px;font-size:13px;color:var(--muted)}
.scut kbd{font-family:var(--mono);font-size:11px;padding:3px 8px;border-radius:6px;border:1px solid var(--border2);background:var(--card2);color:var(--accent2);flex:none}
/* popover */
#termPop{position:fixed;z-index:120;width:300px;max-width:calc(100vw - 24px);background:var(--bg2);
  border:1px solid var(--border2);border-radius:14px;padding:16px;box-shadow:0 20px 60px rgba(0,0,0,.5);display:none;animation:cardin .2s ease both}
#termPop h4{color:var(--accent);font-size:15px;margin-bottom:6px;letter-spacing:.04em}
#termPop .tp{margin-bottom:10px;font-size:13px}
#termPop .tp b{display:block;font-size:9px;letter-spacing:.16em;color:var(--muted);margin-bottom:3px}
/* misc */
.muted{color:var(--muted)}
.empty{color:var(--faint);font-size:13px;text-align:center;padding:20px 0}
footer{max-width:1440px;margin:0 auto;padding:0 20px 40px;color:var(--faint);font-size:11.5px;display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap}
@media(max-width:720px){
  main{padding:14px 12px 50px}
  #mapbar{padding:8px 12px;top:53px}
  header{padding:10px 12px}
  .brand small{display:none}
  .card{padding:20px 16px}
  .sheet{padding:22px 16px}
}
@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.001s !important;animation-iteration-count:1 !important;transition-duration:.001s !important}
  html{scroll-behavior:auto}
}
</style>
</head>
<body>

<header>
