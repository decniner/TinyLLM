/* ---------- APP STATE ---------- */
const state = {
  curStep: 1,
  completed: new Set(),
  theme: 'dark',
  sound: true,
  mode: 'learn', // 'learn', 'quiz', 'review', 'mem'
  playbackSpeed: 1.0,
  isSpeaking: false
};

/* ---------- DOM ELEMENTS ---------- */
const $ = id => document.getElementById(id);
const cardwrap = $('cardwrap');
const mapscroll = $('mapscroll');
const ringfg = $('ringfg');
const ringtxt = $('ringtxt');
const headStepTxt = $('headStepTxt');
const headChapTxt = $('headChapTxt');

/* ---------- INITIALIZATION ---------- */
function init() {
  loadSavedState();
  renderMapBar();
  renderStep(state.curStep);
  renderRailPanels();
  setupEventListeners();
  setupShortcuts();
  updateProgressUI();
}

/* ---------- LOCAL STORAGE ---------- */
function loadSavedState() {
  try {
    const saved = localStorage.getItem('tiny_llm_state');
    if (saved) {
      const parsed = JSON.parse(saved);
      state.curStep = parsed.curStep || 1;
      state.completed = new Set(parsed.completed || []);
      state.theme = parsed.theme || 'dark';
      state.sound = parsed.sound !== undefined ? parsed.sound : true;
    }
  } catch(e) { console.error('Failed to load state', e); }
  document.documentElement.setAttribute('data-theme', state.theme);
  updateSoundBtn();
}

function saveState() {
  try {
    localStorage.setItem('tiny_llm_state', JSON.stringify({
      curStep: state.curStep,
      completed: Array.from(state.completed),
      theme: state.theme,
      sound: state.sound
    }));
  } catch(e) { console.error('Failed to save state', e); }
}

/* ---------- RENDER MAP BAR ---------- */
function renderMapBar() {
  mapscroll.innerHTML = MAPSTAGES.map(([label, stepNum]) => {
    const isDone = state.completed.has(stepNum);
    const isCur = state.curStep === stepNum;
    const cls = `mapnode ${isDone ? 'done' : ''} ${isCur ? 'cur' : ''}`;
    return `<button class="${cls}" data-step="${stepNum}">
      <span class="lbl">${label}</span>
      <span class="st">STEP ${stepNum}</span>
    </button><span class="maparrow">›</span>`;
  }).join('').slice(0, -27); // remove trailing arrow
}

/* ---------- RENDER STEP CARD ---------- */
function renderStep(n) {
  state.curStep = n;
  saveState();
  const s = STEPS.find(item => item.n === n);
  if (!s) return;

  const chap = chapOf(n);
  headStepTxt.textContent = `STEP ${n}`;
  headChapTxt.textContent = `CHAPTER ${chap.id} · ${chap.name}`;

  // Mode header / toggle
  let modeHeader = '';
  if (state.mode === 'quiz') modeHeader = `<div class="modehead"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>KNOWLEDGE CHECK MODE</div>`;
  else if (state.mode === 'review') modeHeader = `<div class="modehead" style="color:var(--amber)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 4v6h6"/><path d="M3.51 15a9 9 0 102.13-9.36L1 10"/></svg>REVISION MODE</div>`;
  else if (state.mode === 'mem') modeHeader = `<div class="modehead" style="color:var(--violet)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>MEMORY REBUILD MODE</div>`;

  // Chain navigation
  const prevS = STEPS.find(x => x.n === n - 1);
  const nextS = STEPS.find(x => x.n === n + 1);
  const chainHtml = `
    <div class="chain">
      ${prevS ? `<div class="c prev" data-step="${n-1}"><b>‹ PREVIOUS</b>${prevS.t}</div>` : `<div></div>`}
      <div class="c now"><b>CURRENT STEP ${n} OF 30</b>${s.t}</div>
      ${nextS ? `<div class="c next" data-step="${n+1}"><b>NEXT ›</b>${nextS.t}</div>` : `<div></div>`}
    </div>`;

  let mainBodyHtml = '';

  if (state.mode === 'learn') {
    // Standard Learn Mode
    const rememberTags = (s.rem || []).map(r => `<span class="rtag">${highlightTerms(r)}</span>`).join('');
    
    let ioHtml = '';
    if (s.inp || s.proc || s.out) {
      ioHtml = `<div class="io">
        <div class="io-col"><h4>INPUT</h4><p>${highlightTerms(s.inp || '')}</p></div>
        <div class="io-col proc"><h4>PROCESS</h4><p>${highlightTerms(s.proc || '')}</p></div>
        <div class="io-col"><h4>OUTPUT</h4><p>${highlightTerms(s.out || '')}</p></div>
      </div>`;
    }

    let flowHtml = '';
    if (s.flow) {
      flowHtml = `<div class="flow">` + s.flow.map(f => `
        <div class="frow">
          <span class="fl">${f[0]}</span>
          <span class="fv ${f[2]==='+'?'pos':f[2]==='-'?'neg':''}">${f[1]}</span>
        </div>
        ${f[2] ? `<span class="fop">${f[2]}</span>` : ''}
      `).join('<span class="farrow">↓</span>') + `</div>`;
    }

    mainBodyHtml = `
      <p class="purpose">${highlightTerms(s.w)}</p>
      ${chainHtml}
      ${ioHtml}
      ${flowHtml}
      ${s.m ? `<div class="mathbox"><h4>MATH & FORMULA</h4><div class="eq">${s.m[1]}</div><div class="mlabel">${s.m[0]}</div></div>` : ''}
      ${s.eli5 ? `<div class="eli5"><h4>ELI5 · SIMPLE ANALOGY</h4><p>${highlightTerms(s.eli5)}</p></div>` : ''}
      ${s.pic ? `<div class="tech"><h4>VISUAL CONCEPT</h4><p>${highlightTerms(s.pic)}</p></div>` : ''}
      ${rememberTags ? `<div class="remember">${rememberTags}</div>` : ''}
    `;
  } else if (state.mode === 'quiz') {
    // Quiz Mode
    const qList = (s.qz || []).map((q, idx) => `
      <div class="quizq" id="qz_${idx}">
        <div class="q">${idx + 1}. ${q.q}</div>
        <button class="btn sm primary btn-show-ans" data-target="qz_${idx}">Reveal Answer</button>
        <div class="a">${q.a}</div>
      </div>
    `).join('');
    mainBodyHtml = `
      <p class="purpose">Test your understanding of <b>${s.t}</b> before moving on.</p>
      ${chainHtml}
      <div style="margin:16px 0">${qList || '<p class="muted">No quiz questions for this step.</p>'}</div>
    `;
  } else if (state.mode === 'review') {
    // Review Mode
    mainBodyHtml = `
      <p class="purpose">Quick revision summary for <b>${s.t}</b>.</p>
      ${chainHtml}
      <div class="revbox">
        <h4 style="font-size:11px;letter-spacing:.14em;color:var(--amber);margin-bottom:8px">STEP REVISION SUMMARY</h4>
        <p style="font-size:14px;margin-bottom:10px"><b>Input:</b> ${s.rv ? s.rv.inp : s.inp}</p>
        <p style="font-size:14px;margin-bottom:10px"><b>Output:</b> ${s.rv ? s.rv.out : s.out}</p>
        <p style="font-size:14px;color:var(--text)"><b>Core Takeaway:</b> ${s.p}</p>
      </div>
    `;
  } else if (state.mode === 'mem') {
    // Memory Rebuild Mode
    mainBodyHtml = `
      <p class="purpose">Rebuild the mental model for <b>${s.t}</b> in 10 seconds.</p>
      ${chainHtml}
      <div class="memgrid">
        <div class="mg"><h5>1-SENTENCE SUMMARY</h5><p>${s.mem ? s.mem.one : s.p}</p></div>
        <div class="mg"><h5>MENTAL IMAGE</h5><p>${s.mem ? s.mem.img : s.pic}</p></div>
        <div class="mg"><h5>CORE EQUATION / PATTERN</h5><div class="eq">${s.mem ? s.mem.eq : (s.m ? s.m[1] : 'N/A')}</div></div>
        <div class="mg"><h5>ONE THING TO REMEMBER</h5><p>${s.mem ? s.mem.oneR : (s.rem ? s.rem[0] : '')}</p></div>
      </div>
    `;
  }

  // Audio / Narration Bar
  const audioBarHtml = `
    <div class="audiobar ${state.sound ? 'show' : ''}" id="audioBar">
      <span class="ab-lbl">NARRATION</span>
      <button class="btn sm primary" id="btnPlayAudio">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg> Play
      </button>
      <button class="btn sm ghost" id="btnStopAudio">Stop</button>
      <span style="margin-left:auto;display:flex;gap:4px;align-items:center">
        <span style="font-size:10px;color:var(--muted)">SPEED:</span>
        <button class="speedbtn ${state.playbackSpeed===1.0?'on':''}" data-spd="1.0">1x</button>
        <button class="speedbtn ${state.playbackSpeed===1.25?'on':''}" data-spd="1.25">1.25x</button>
        <button class="speedbtn ${state.playbackSpeed===1.5?'on':''}" data-spd="1.5">1.5x</button>
      </span>
    </div>
  `;

  // Controls footer
  const controlsHtml = `
    <div class="controls">
      <button class="modebtn ${state.mode==='learn'?'on':''}" data-mode="learn">LEARN</button>
      <button class="modebtn ${state.mode==='quiz'?'on':''}" data-mode="quiz">QUIZ</button>
      <button class="modebtn ${state.mode==='review'?'on':''}" data-mode="review">REVISION</button>
      <button class="modebtn ${state.mode==='mem'?'on':''}" data-mode="mem">MEMORY</button>
      <div class="spacer"></div>
      <button class="btn primary sm" id="btnMarkDone">
        ${state.completed.has(n) ? '✓ Completed' : 'Mark as Complete'}
      </button>
    </div>
  `;

  cardwrap.innerHTML = `
    <article class="card">
      <div class="meta">
        <span class="stepno">STEP ${s.n} OF 30</span>
        <span class="chip cur"><span class="dot"></span>${chap.name}</span>
      </div>
      <h2>${s.t}</h2>
      ${modeHeader}
      ${mainBodyHtml}
      ${audioBarHtml}
      ${controlsHtml}
    </article>
  `;

  // Mark step done automatically on view or keep manual button
  updateMapHighlight();
  if (state.sound && state.mode === 'learn') playNarration();
}

/* ---------- HIGHLIGHT TERMINOLOGY ---------- */
function highlightTerms(text) {
  if (!text) return '';
  let res = text;
  Object.keys(TERMS).forEach(term => {
    const reg = new RegExp(`\\b(${term}s?)\\b`, 'gi');
    res = res.replace(reg, match => `<button class="term" data-term="${term}">${match}</button>`);
  });
  return res;
}

/* ---------- UPDATE MAP & PROGRESS ---------- */
function updateMapHighlight() {
  document.querySelectorAll('.mapnode').forEach(node => {
    const st = parseInt(node.getAttribute('data-step'), 10);
    node.classList.toggle('cur', st === state.curStep);
    node.classList.toggle('done', state.completed.has(st));
  });

  const count = state.completed.size;
  ringtxt.textContent = `${count}/30`;
  const offset = 97.4 - (97.4 * count / 30);
  ringfg.style.strokeDashoffset = offset;
}

function updateProgressUI() {
  updateMapHighlight();
}

/* ---------- RAIL PANELS RENDER ---------- */
function renderRailPanels() {
  renderNeuralNet();
  renderChart();
  renderLearningLoop();
}

function renderNeuralNet() {
  const svg = `
    <svg viewBox="0 0 280 170">
      <!-- Links -->
      ${EMB_THE.map((_, i) => HIDDEN.map((_, j) => `
        <line class="nlink ${j===0||j===3?'live':''}" x1="30" y1="${25 + i*40}" x2="140" y2="${20 + j*42}"/>
      `).join('')).join('')}
      ${HIDDEN.map((h, i) => Array.from({length:9}).map((_, j) => `
        <line class="nlink ${h.out>0?'live':''}" x1="140" y1="${20 + i*42}" x2="250" y2="${10 + j*18}"/>
      `).join('')).join('')}

      <!-- Input Layer (4) -->
      ${EMB_THE.map((v, i) => `
        <circle class="nnode active" cx="30" cy="${25 + i*40}" r="10" data-tt="Input Emb ${i}:${v}"/>
        <text class="nlabel" x="5" y="${28 + i*40}">x${i}</text>
      `).join('')}

      <!-- Hidden Layer (4) -->
      ${HIDDEN.map((h, i) => `
        <circle class="nnode ${h.out>0?'active':''}" cx="140" cy="${20 + i*42}" r="12" data-tt="Neuron ${i}: z=${h.z.toFixed(3)}, out=${h.out.toFixed(3)}"/>
        <text class="nlabel" x="136" y="${23 + i*42}">h${i}</text>
      `).join('')}

      <!-- Output Layer (9 sample dots) -->
      ${Array.from({length:9}).map((_, i) => `
        <circle class="nnode ${i===1?'active':''}" cx="250" cy="${10 + i*18}" r="6" data-tt="Output Logit ${i}"/>
      `).join('')}
    </svg>
  `;
  $('nnwrap').innerHTML = svg;
}

function renderChart() {
  const svg = `
    <svg viewBox="0 0 280 100">
      <path d="M 20 80 Q 80 75, 140 30 T 260 20" fill="none" stroke="var(--accent)" stroke-width="2"/>
      <path d="M 20 85 Q 80 80, 140 50 T 260 30" fill="none" stroke="var(--accent2)" stroke-width="2"/>
      <circle cx="140" cy="30" r="4" fill="var(--amber)"/>
      <circle cx="260" cy="20" r="4" fill="var(--amber)"/>
    </svg>
  `;
  $('chartwrap').innerHTML = svg;
}

function renderLearningLoop() {
  const stages = [
    {n:1, l:"FORWARD PASS", s:"Predict next word"},
    {n:2, l:"LOSS FUNCTION", s:"Calculate error"},
    {n:3, l:"BACKPROPAGATION", s:"Assign blame"},
    {n:4, l:"WEIGHT UPDATE", s:"Adjust parameters"}
  ];
  $('loopviz').innerHTML = stages.map((st, i) => `
    <div class="loopnode ${i===0?'hot':''}">
      <span>${st.l}</span>
      <span style="margin-left:auto;font-size:9px;color:var(--faint)">${st.s}</span>
    </div>
    ${i < 3 ? `<div class="looparrow">↓</div>` : ''}
  `).join('');
}

/* ---------- VOICE NARRATION ---------- */
function playNarration() {
  if (!('speechSynthesis' in window) || !state.sound) return;
  window.speechSynthesis.cancel();
  const s = STEPS.find(x => x.n === state.curStep);
  if (!s) return;

  const txt = `${s.t}. ${s.p}. ${s.w}`;
  const utter = new SpeechSynthesisUtterance(txt);
  utter.rate = state.playbackSpeed;
  utter.onstart = () => { state.isSpeaking = true; updateAudioBtnUI(); };
  utter.onend = () => { state.isSpeaking = false; updateAudioBtnUI(); };
  utter.onerror = () => { state.isSpeaking = false; updateAudioBtnUI(); };
  window.speechSynthesis.speak(utter);
}

function stopNarration() {
  if ('speechSynthesis' in window) {
    window.speechSynthesis.cancel();
    state.isSpeaking = false;
    updateAudioBtnUI();
  }
}

function updateAudioBtnUI() {
  const btn = $('btnPlayAudio');
  if (btn) {
    btn.innerHTML = state.isSpeaking ? 
      `<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg> Pause` :
      `<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg> Play`;
  }
}

/* ---------- EVENT LISTENERS ---------- */
function setupEventListeners() {
  // Navigation delegation
  document.addEventListener('click', e => {
    const btnStep = e.target.closest('[data-step]');
    if (btnStep) {
      const st = parseInt(btnStep.getAttribute('data-step'), 10);
      renderStep(st);
      return;
    }

    const btnTerm = e.target.closest('.term');
    if (btnTerm) {
      showTermPopover(btnTerm.getAttribute('data-term'), e);
      return;
    }

    const btnMode = e.target.closest('[data-mode]');
    if (btnMode) {
      state.mode = btnMode.getAttribute('data-mode');
      renderStep(state.curStep);
      return;
    }

    const btnShowAns = e.target.closest('.btn-show-ans');
    if (btnShowAns) {
      const targetId = btnShowAns.getAttribute('data-target');
      const qEl = $(targetId);
      if (qEl) qEl.classList.toggle('open');
      return;
    }

    const btnClose = e.target.closest('[data-close]');
    if (btnClose) {
      const ov = btnClose.closest('.overlay');
      if (ov) ov.classList.remove('show');
      return;
    }

    // Close term popover if clicking outside
    if (!e.target.closest('#termPop') && !e.target.closest('.term')) {
      $('termPop').style.display = 'none';
    }
  });

  // Controls
  $('btnStart').onclick = () => { $('welcome').classList.remove('show'); renderStep(1); };$('btnTheme').onclick = () => {
    state.theme = state.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', state.theme);
    saveState();
  };
  $('btnSound').onclick = () => {
    state.sound = !state.sound;
    updateSoundBtn();
    if (!state.sound) stopNarration();
    else playNarration();
    saveState();
  };
  $('btnReset').onclick = () => {
    if (confirm("Reset all course progress?")) {
      state.completed.clear();
      state.curStep = 1;
      saveState();
      updateProgressUI();
      renderStep(1);
    }
  };

  // Overlays
  $('btnMap').onclick = () => showMemoryMap();$('btnSearch').onclick = () => showSearch();
  $('btnKeys').onclick = () =>$('keysov').classList.add('show');

  // Search Input
  $('searchinput').oninput = e => handleSearch(e.target.value);

  // Audio delegation inside card
  document.addEventListener('click', e => {
    if (e.target.closest('#btnPlayAudio')) {
      if (state.isSpeaking) stopNarration();
      else playNarration();
    }
    if (e.target.closest('#btnStopAudio')) stopNarration();
    const spdBtn = e.target.closest('.speedbtn');
    if (spdBtn) {
      state.playbackSpeed = parseFloat(spdBtn.getAttribute('data-spd'));
      document.querySelectorAll('.speedbtn').forEach(b => b.classList.toggle('on', b === spdBtn));
      if (state.isSpeaking) playNarration();
    }
    if (e.target.closest('#btnMarkDone')) {
      if (state.completed.has(state.curStep)) state.completed.delete(state.curStep);
      else state.completed.add(state.curStep);
      saveState();
      updateProgressUI();
      renderStep(state.curStep);
    }
  });

  // Tooltips for Neural Net
  document.addEventListener('mouseover', e => {
    const node = e.target.closest('[data-tt]');
    const tip = $('nntip');
    if (node) {
      tip.innerHTML = `<div class="tt">DETAILS</div>${node.getAttribute('data-tt')}`;
      tip.style.display = 'block';
      tip.style.left = (e.clientX + 10) + 'px';
      tip.style.top = (e.clientY + 10) + 'px';
    } else if (tip) {
      tip.style.display = 'none';
    }
  });
}

function updateSoundBtn() {
  const btn = $('btnSound');
  btn.classList.toggle('on', state.sound);
}

/* ---------- POPOVER & OVERLAYS ---------- */
function showTermPopover(termKey, e) {
  const info = TERMS[termKey.toLowerCase()];
  if (!info) return;
  const pop = $('termPop');
  pop.innerHTML = `
    <h4>${termKey.toUpperCase()}</h4>
    <div class="tp"><b>DEFINITION</b>${info.d}</div>
    <div class="tp"><b>ELI5</b>${info.eli5}</div>
    <div class="tp"><b>WHY IT MATTERS</b>${info.why}</div>
  `;
  pop.style.display = 'block';
  const rect = e.target.getBoundingClientRect();
  pop.style.left = Math.min(rect.left, window.innerWidth - 320) + 'px';
  pop.style.top = (rect.bottom + 8) + 'px';
}

function showMemoryMap() {
  const body = $('memmapbody');
  body.innerHTML = CHAPTERS.map(c => `
    <div class="memchap">
      <h4>CHAPTER ${c.id}: ${c.name}</h4>
      <p class="mm">${c.model}</p>
      <div class="memsteps">
        ${STEPS.filter(s => s.n >= c.range[0] && s.n <= c.range[1]).map(s => `
          <button class="mstep ${state.completed.has(s.n)?'done':''}" data-step="${s.n}">
            ${s.n}.${s.t}
          </button>
        `).join('')}
      </div>
    </div>
  `).join('');
  $('memmap').classList.add('show');
}

function showSearch() {
  $('searchov').classList.add('show');$('searchinput').focus();
}

function handleSearch(query) {
  const q = query.toLowerCase().trim();
  const resContainer = $('searchres');
  if (!q) { resContainer.innerHTML = ''; return; }

  const matches = STEPS.filter(s => 
    s.t.toLowerCase().includes(q) || 
    s.w.toLowerCase().includes(q) || 
    s.p.toLowerCase().includes(q)
  );

  if (matches.length === 0) {
    resContainer.innerHTML = `<div class="empty">No matching steps found</div>`;
    return;
  }

  resContainer.innerHTML = matches.map(s => `
    <button class="sres" data-step="${s.n}">
      <span class="sn">${s.n}</span>
      <div>
        <div class="st">${s.t}</div>
        <div class="sx">${s.p}</div>
      </div>
    </button>
  `).join('');
}

/* ---------- KEYBOARD SHORTCUTS ---------- */
function setupShortcuts() {
  const scuts = [
    {k:"← / →", d:"Previous / Next step"},
    {k:"/ ", d:"Search course"},
    {k:"M", d:"Toggle Master Memory Map"},
    {k:"S", d:"Toggle voice narration"},
    {k:"?", d:"Keyboard shortcuts"}
  ];
  $('scutsbody').innerHTML = scuts.map(s => `
    <div class="scut"><kbd>${s.k}</kbd><span>${s.d}</span></div>
  `).join('');

  document.addEventListener('keydown', e => {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
    if (e.key === 'ArrowRight' && state.curStep < 30) renderStep(state.curStep + 1);
    if (e.key === 'ArrowLeft' && state.curStep > 1) renderStep(state.curStep - 1);
    if (e.key === '/') { e.preventDefault(); showSearch(); }
    if (e.key === 'm' || e.key === 'M') showMemoryMap();
    if (e.key === 's' || e.key === 'S') $('btnSound').click();
    if (e.key === '?') $('keysov').classList.toggle('show');
  });
}

// Boot application
window.addEventListener('DOMContentLoaded', init);
</script>
</body>
</html>
