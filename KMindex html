/* ---------- STATE ---------- */
const LS_KEY = "tinyllm_progress_v1";
let state = { step:1, completed:{}, review:{}, sound:true };
try{
  const raw = localStorage.getItem(LS_KEY);
  if(raw) state = Object.assign(state, JSON.parse(raw));
}catch(e){}
function save(){ try{ localStorage.setItem(LS_KEY, JSON.stringify(state)); }catch(e){} }
let mode = "learn";           // learn | quiz | reverse | memory
const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

/* ---------- HELPERS ---------- */
const $ = s => document.querySelector(s);
const esc = s => s;
function linkify(text){
  // wrap known terms in clickable buttons (longest first)
  let out = text;
  Object.keys(TERMS).sort((a,b)=>b.length-a.length).forEach(t=>{
    const re = new RegExp("(?<![\\w>])"+t.replace(/[.*+?^${}()|[\]\\]/g,"\\$&")+"(?![\\w<])","gi");
    out = out.replace(re, m => `<button class="term" data-term="${t}">${m}</button>`);
  });
  return out;
}
function flowHTML(rows){
  return `<div class="flow">${rows.map((r,i)=>{
    const v = r[1];
    const cls = v.startsWith("−")||v.startsWith("-") ? "fv neg" : (/^\+|^0\.\d|^\d/.test(v)&&!v.includes("→")&&!/[a-zA-Z]/.test(v.replace(/[−\.,\[\]\s]/g,""))) ? "fv pos" : "fv";
    return `${i?`<div class="farrow">↓</div>`:""}<div class="frow"><span class="fl">${r[0]}</span><span class="${cls}">${v}</span>${r[2]?`<span class="fop">${r[2]}</span>`:""}</div>`;
  }).join("")}</div>`;
}
function stepStatus(n){
  if(state.review[n]) return "review";
  if(state.completed[n]) return "done";
  if(n === state.step) return "cur";
  return "up";
}

/* ---------- RENDER: header + map ---------- */
function renderHeader(){
  const done = Object.keys(state.completed).length;
  $("#ringtxt").textContent = done + "/30";
  $("#ringfg").style.strokeDashoffset = (97.4 * (1 - done/30)).toFixed(1);
  $("#headStepTxt").textContent = "STEP " + state.step + " OF 30";
  $("#headChapTxt").textContent = chapLabel(state.step);
}
function renderMap(){
  $("#mapscroll").innerHTML = MAPSTAGES.map(([lbl,sn],i)=>{
    const st = stepStatus(sn);
    const curCls = sn === state.step ? " cur" : st === "done" ? " done" : "";
    return `<button class="mapnode${curCls}" data-go="${sn}" title="Step ${sn} · ${STEPS[sn-1].t}">
      <span class="lbl">${lbl}</span><span class="st">${st==="done"?"✓ done":st==="cur"?"● now":"step "+sn}</span>
    </button>${i<MAPSTAGES.length-1?`<span class="maparrow" aria-hidden="true">→</span>`:""}`;
  }).join("");
}

/* ---------- RENDER: card ---------- */
function renderCard(){
  const s = STEPS[state.step-1];
  const prev = STEPS[state.step-2], next = STEPS[state.step+1];
  const st = stepStatus(s.n);
  const stChip = st==="done" ? `<span class="chip done"><span class="dot"></span>COMPLETED</span>`
    : st==="review" ? `<span class="chip review"><span class="dot"></span>TO REVIEW</span>`
    : `<span class="chip cur"><span class="dot"></span>IN PROGRESS</span>`;

  let body = "";
  if(mode === "learn"){
    body = `
    <div class="chain">
      <div class="c prev" data-go="${prev?prev.n:1}" role="button" tabindex="0"><b>WHAT CAME BEFORE</b>${prev?("Step "+prev.n+" · "+esc(prev.t)):"—"}</div>
      <div class="c now"><b>WHAT HAPPENS NOW</b>${esc(s.p)}</div>
      <div class="c next" data-go="${next?next.n:30}" role="button" tabindex="0"><b>WHAT HAPPENS NEXT</b>${next?("Step "+next.n+" · "+esc(next.t)):"Course complete"}</div>
    </div>
    <div class="grid2">
      <div class="block"><h4>WHY IT EXISTS</h4><p>${linkify(s.w)}</p></div>
      <div class="block"><h4>MENTAL PICTURE</h4><p>${esc(s.pic)}</p></div>
    </div>
    <div class="io">
      <div class="io-col"><h4>INPUT — what goes in</h4><p>${linkify(s.inp)}</p></div>
      <div class="io-col proc"><h4>PROCESS — what happens</h4><p>${linkify(s.proc)}</p></div>
      <div class="io-col"><h4>OUTPUT — what comes out</h4><p>${linkify(s.out)}</p></div>
    </div>
    ${s.flow?flowHTML(s.flow):""}
    <div class="mathbox"><h4>SIMPLE MATH</h4><div class="eq">${s.m[1]}</div><div class="mlabel">${s.m[0]}</div></div>
    <div class="tech"><h4>TECHNICAL VERSION</h4><p>${linkify(s.proc)} ${linkify(s.w)}</p></div>
    <div class="eli5"><h4>EXPLAIN LIKE I'M 5</h4><p>${esc(s.eli5)}</p></div>
    <div class="remember">${s.rem.map(r=>`<span class="rtag">${esc(r)}</span>`).join("")}</div>`;
  }
  else if(mode === "quiz"){
    body = `<div class="modehead">ACTIVE RECALL — answer before revealing</div>
      ${s.qz.map((q,i)=>`<div class="quizq" data-qi="${i}"><div class="q">${i+1}. ${esc(q.q)}</div>
        <button class="btn sm ghost" data-reveal="${i}">REVEAL ANSWER</button>
        <div class="a">${esc(q.a)}</div></div>`).join("")}
      <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:6px">
        <button class="btn primary" data-gotit="1">I GOT IT</button>
        <button class="btn" data-review="1">I NEED TO REVIEW</button>
      </div>
      <p class="muted" style="font-size:12px;margin-top:12px">Answer each question in your head first. Retrieval — not rereading — builds memory. Status is saved locally.</p>`;
  }
  else if(mode === "reverse"){
    body = `<div class="modehead">REVERSE IT — explain the result</div>
      <div class="revbox">
        <div class="frow" style="align-items:flex-start"><span class="fl">INPUT</span><span class="fv mono" style="font-size:14px">${esc(s.rv.inp)}</span></div>
        <div class="farrow" style="text-align:center">↓</div>
        <div class="frow"><span class="fl">OUTPUT</span><span class="fv pos" style="font-size:16px">${esc(s.rv.out)}</span></div>
      </div>
      <div class="quizq"><div class="q">${esc(s.rv.q)}</div>
        <button class="btn sm ghost" data-reveal="0">REVEAL ANSWER</button>
        <div class="a">${esc(s.rv.a)}</div></div>
      <p class="muted" style="font-size:12px">Explaining a result yourself is the strongest test of understanding.</p>`;
  }
  else if(mode === "memory"){
    const mm = s.mem;
    body = `<div class="modehead">MEMORY MODE — compress this step</div>
      <div class="memgrid">
        <div class="mg"><h5>ONE-LINE VERSION</h5><p>${esc(mm.one)}</p></div>
        <div class="mg"><h5>MENTAL IMAGE</h5><p>${esc(mm.img)}</p></div>
        <div class="mg"><h5>KEY EQUATION</h5><div class="eq">${mm.eq}</div></div>
        <div class="mg"><h5>ONE THING TO REMEMBER</h5><p>${esc(mm.oneR)}</p></div>
        <div class="mg"><h5>ACTIVE RECALL</h5><p>${esc(mm.recall)}</p>
          <button class="btn sm ghost" data-reveal="0" style="margin-top:8px">REVEAL</button>
          <div class="a quizq" style="display:none;border:none;padding:8px 0 0;margin-top:8px"><div class="a" style="display:block;border:none;padding:0;color:var(--green)">${esc(s.qz[0].a)}</div></div>
        </div>
      </div>`;
  }

  // step 30 finale
  let finale = "";
  if(s.n === 30){
    const j = ["TEXT","TOKENS","NUMBERS","HIDDEN REPRESENTATION","LOGITS","PROBABILITIES","LOSS","GRADIENTS","UPDATED PARAMETERS","TRAINING","PREDICTION","GENERATED TEXT"];
    finale = `<div style="text-align:center;margin-top:26px;border-top:1px solid var(--border);padding-top:26px">
      <p style="font-size:12px;letter-spacing:.18em;color:var(--accent);margin-bottom:14px">THE ENTIRE JOURNEY</p>
      <div class="jchain">${j.map((w,i)=>`<span class="jchip">${w}</span>${i<j.length-1?`<span class="jarrow">→</span>`:""}`).join("")}</div>
      <p style="font-size:17px;font-weight:600;margin:16px 0 4px">YOU NOW UNDERSTAND THE BASIC TRAINING LOOP OF A TINY LANGUAGE MODEL.</p>
      <p class="mono" style="color:var(--accent);letter-spacing:.2em;font-size:12px;margin-bottom:16px">30 STEPS COMPLETE</p>
      <button class="btn primary" data-go-map="1">REPLAY FROM THE MASTER MAP</button>
    </div>`;
  }

  $("#cardwrap").innerHTML = `<article class="card">
    <div class="meta"><span class="stepno">STEP ${s.n} OF 30</span>
      <span class="chip"><span class="dot" style="background:var(--accent2)"></span>${chapLabel(s.n)}</span>${stChip}</div>
    <h2>${esc(s.t)}</h2>
    <p class="purpose">${esc(s.p)}</p>
    ${body}${finale}
    <div class="controls">
      <button class="btn ghost" data-prev ${!prev?"disabled":""}>← PREVIOUS</button>
      <button class="modebtn ${mode==='quiz'?'on':''}" data-mode="quiz" title="Q">QUIZ ME</button>
      <button class="modebtn ${mode==='reverse'?'on':''}" data-mode="reverse">REVERSE IT</button>
      <button class="modebtn ${mode==='memory'?'on':''}" data-mode="memory" title="M">MEMORY MODE</button>
      <span class="spacer"></span>
      <button class="btn" data-hear title="Space">▶ HEAR THIS</button>
      <button class="btn primary" data-next>${state.step===30?"FINISH":"NEXT STEP"} →</button>
    </div>
    <div class="audiobar" id="audiobar">
      <span class="ab-lbl">VOICE</span>
      <button class="btn sm" data-audio="pause">⏸ Pause</button>
      <button class="btn sm" data-audio="stop">⏹ Stop</button>
      <span class="muted" style="font-size:11px">speed</span>
      ${[0.8,1.0,1.2,1.5].map(r=>`<button class="speedbtn ${r===1.0?'on':''}" data-speed="${r}">${r}×</button>`).join("")}
    </div>
  </article>`;
  renderHeader(); renderMap();
}

/* ---------- NEURAL NETWORK VIZ ---------- */
function buildNN(){
  const words = ["The","quick","brown","fox","jumps","over","the","lazy","dog"];
  const W=330,H=320, xs=[42,165,290];
  const yIn=i=>60+i*66, yH=i=>60+i*66, yO=i=>26+i*32;
  let svg = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Tiny neural network: 4 inputs, 4 hidden neurons, 9 outputs">`;
  // links
  for(let i=0;i<4;i++)for(let j=0;j<4;j++)
    svg+=`<line class="nlink live" data-nn="w₁[${i}][${j}] · hidden neuron ${j}" x1="${xs[0]+11}" y1="${yIn(i)}" x2="${xs[1]-13}" y2="${yH(j)}"/>`;
  for(let j=0;j<4;j++)for(let k=0;k<9;k++)
    svg+=`<line class="nlink ${HIDDEN[j].out>0?'live':''}" data-nn="w₂[${j}][${k}] · output '${words[k]}'" x1="${xs[1]+11}" y1="${yH(j)}" x2="${xs[2]-13}" y2="${yO(k)}"/>`;
  // nodes
  for(let i=0;i<4;i++)
    svg+=`<g data-nn="INPUT ${i} · embedding value of 'The' = ${f6(EMB_THE[i])}"><circle class="nnode" cx="${xs[0]}" cy="${yIn(i)}" r="10"/><text class="nvalue" x="${xs[0]}" y="${yIn(i)+3}" text-anchor="middle">${EMB_THE[i].toFixed(2)}</text><text class="nlabel" x="${xs[0]-14}" y="${yIn(i)+3}" text-anchor="end">x${i}</text></g>`;
  for(let j=0;j<4;j++){
    const h=HIDDEN[j];
    svg+=`<g data-nn="HIDDEN ${j} · sum ${f6(h.sum)} + bias ${f6(h.bias)} → z ${h.z>=0?'+':''}${f6(h.z)} → ReLU ${f6(h.out)}"><circle class="nnode ${h.out>0?'active':''}" cx="${xs[1]}" cy="${yH(j)}" r="12"/><text class="nvalue" x="${xs[1]}" y="${yH(j)+3}" text-anchor="middle">${h.out.toFixed(2)}</text><text class="nlabel" x="${xs[1]-16}" y="${yH(j)+3}" text-anchor="end">h${j}</text></g>`;
  }
  for(let k=0;k<9;k++)
    svg+=`<g data-nn="OUTPUT ${k} · '${words[k]}' · softmax probability over this word"><circle class="nnode" cx="${xs[2]}" cy="${yO(k)}" r="9"/><text class="nlabel" x="${xs[2]+13}" y="${yO(k)+3}">${words[k]}</text></g>`;
  svg+=`<text class="nlabel" x="${xs[0]}" y="24" text-anchor="middle">INPUT · 4</text>
        <text class="nlabel" x="${xs[1]}" y="24" text-anchor="middle">HIDDEN · 4</text>
        <text class="nlabel" x="${xs[2]}" y="12" text-anchor="middle">OUTPUT · 9</text></svg>`;
  $("#nnwrap").innerHTML = svg;
}

/* ---------- TRAINING CHART ---------- */
function buildChart(){
  // verified checkpoints (step, loss, pquick) measured before update
  const ptsL=[[1,2.608369],[20,0.549986]];
  const ptsP=[[1,0.073655],[20,0.576958]];
  const X=s=>20+(s-1)/19*280, YL=v=>110-(v/2.8)*95, YP=v=>215-(v/0.65)*80;
  const curve=(pf,yf)=>{let d="";for(let s=1;s<=20;s++){const t=(s-1)/19,e=Math.exp(-3.2*t);const l=2.608369-(2.608369-0.549986)*(1-e)/(1-Math.exp(-3.2));const p=0.073655+(0.576958-0.073655)*(1-e)/(1-Math.exp(-3.2));const x=X(s),y=yf(s===1?pf[0][1]:s===20?pf[1][1]:(pf===ptsL?l:p));d+=(s?"L":"M")+x.toFixed(1)+","+y.toFixed(1)+" ";}return d;};
  let svg=`<svg viewBox="0 0 320 240">
    <line x1="20" y1="110" x2="300" y2="110" stroke="var(--border)"/>
    <line x1="20" y1="215" x2="300" y2="215" stroke="var(--border)"/>
    <path d="${curve(ptsL,YL)}" fill="none" stroke="var(--accent)" stroke-width="2" stroke-dasharray="5 4" opacity=".55"/>
    <path d="${curve(ptsP,YP)}" fill="none" stroke="var(--accent2)" stroke-width="2" stroke-dasharray="5 4" opacity=".55"/>
    ${ptsL.map(p=>`<circle cx="${X(p[0])}" cy="${YL(p[1])}" r="4" fill="var(--amber)"/><text class="nlabel" x="${X(p[0])}" y="${YL(p[1])-9}" text-anchor="middle" fill="var(--text)">${p[1].toFixed(3)}</text>`).join("")}
    ${ptsP.map(p=>`<circle cx="${X(p[0])}" cy="${YP(p[1])}" r="4" fill="var(--amber)"/><text class="nlabel" x="${X(p[0])}" y="${YP(p[1])+16}" text-anchor="middle" fill="var(--text)">${p[1].toFixed(3)}</text>`).join("")}
    <text class="nlabel" x="20" y="128">loss</text><text class="nlabel" x="20" y="233">P(quick)</text>
    <text class="nlabel" x="300" y="128" text-anchor="end">step 1 → 20</text></svg>`;
  $("#chartwrap").innerHTML = svg;
}

/* ---------- LEARNING LOOP ---------- */
function buildLoop(){
  const nodes=["INPUT","FORWARD PASS","PREDICTION","LOSS","BACKWARD PASS","GRADIENTS","PARAMETER UPDATE","TRY AGAIN"];
  $("#loopviz").innerHTML = nodes.map((n,i)=>`<div class="loopnode${i===0?' hot':''}" data-li="${i}">${n}</div>${i<nodes.length-1?'<div class="looparrow">↓</div>':'<div class="looparrow">↺</div>'}`).join("");
  if(!reduced){
    let i=0;
    setInterval(()=>{
      document.querySelectorAll(".loopnode").forEach(el=>el.classList.remove("hot"));
      i=(i+1)%nodes.length;
      const el=document.querySelector(`.loopnode[data-li="${i}"]`); if(el)el.classList.add("hot");
    },1400);
  }
}

/* ---------- MEMORY MAP ---------- */
function renderMemMap(){
  $("#memmapbody").innerHTML = CHAPTERS.map(c=>{
    const steps=[]; for(let n=c.range[0];n<=c.range[1];n++) steps.push(n);
    return `<div class="memchap"><h4>CHAPTER ${c.id} — ${c.name}</h4>
      <p class="mm">${c.model}</p>
      <div class="memsteps">${steps.map(n=>`<button class="mstep ${state.completed[n]?'done':''}" data-go="${n}">${n}. ${STEPS[n-1].t}</button>`).join("")}</div></div>`;
  }).join("");
}

/* ---------- SEARCH ---------- */
const SEARCH_INDEX = STEPS.map(s=>({
  n:s.n, title:s.t, text:(s.t+" "+s.p+" "+s.w+" "+s.proc+" "+s.m.join(" ")+" "+s.eli5+" "+s.rem.join(" ")).toLowerCase()
}));
function doSearch(q){
  q=q.trim().toLowerCase();
  const resBox=$("#searchres");
  if(!q){resBox.innerHTML=`<div class="empty">Type to search steps, terms, equations, explanations…</div>`;return;}
  const hits=SEARCH_INDEX.filter(e=>e.text.includes(q)).slice(0,12);
  const termHits=Object.keys(TERMS).filter(t=>t.includes(q));
  resBox.innerHTML =
    (termHits.length?`<p class="muted" style="font-size:11px;letter-spacing:.14em;margin-bottom:8px">TERMS</p>`+
      termHits.map(t=>`<button class="sres" data-term="${t}"><span class="sn">TERM</span><span><span class="st">${t}</span><span class="sx">${TERMS[t].d}</span></span></button>`).join(""):"")+
    (hits.length?`<p class="muted" style="font-size:11px;letter-spacing:.14em;margin:12px 0 8px">STEPS</p>`+
      hits.map(h=>`<button class="sres" data-go="${h.n}"><span class="sn">${String(h.n).padStart(2,"0")}</span><span><span class="st">${h.title}</span><span class="sx">${STEPS[h.n-1].p}</span></span></button>`).join(""):"")+
    (!hits.length&&!termHits.length?`<div class="empty">No matches for “${q}”.</div>`:"");
}

/* ---------- SPEECH ---------- */
let rate=1.0;
function speakCurrent(){
  if(!state.sound) return;
  if(!("speechSynthesis" in window)) return;
  const s=STEPS[state.step-1];
  speechSynthesis.cancel();
  const u=new SpeechSynthesisUtterance(`Step ${s.n} of 30. ${s.t}. ${s.p} ${s.w} In simple terms: ${s.eli5}`);
  u.rate=rate; u.pitch=1.0;
  u.onend=()=>$("#audiobar")&&$("#audiobar").classList.remove("show");
  speechSynthesis.speak(u);
  const ab=$("#audiobar"); if(ab)ab.classList.add("show");
}
function toggleSpeech(){
  if(!("speechSynthesis" in window)) return;
  if(speechSynthesis.speaking && !speechSynthesis.paused){ speechSynthesis.pause(); }
  else if(speechSynthesis.paused){ speechSynthesis.resume(); }
  else { speakCurrent(); }
}

/* ---------- NAVIGATION ---------- */
function goTo(n){
  n=Math.max(1,Math.min(30,n));
  state.step=n; save(); mode="learn";
  stopSpeech();
  renderCard();
  window.scrollTo({top:0,behavior:reduced?"auto":"smooth"});
}
function stopSpeech(){ if("speechSynthesis" in window) speechSynthesis.cancel(); }

/* ---------- OVERLAY helpers ---------- */
function showOv(id){ $(id).classList.add("show"); }
function hideOv(id){ $(id).classList.remove("show"); }
function closeAllOv(){ document.querySelectorAll(".overlay").forEach(o=>o.classList.remove("show")); hideTermPop(); }

/* ---------- TERM POPOVER ---------- */
function showTermPop(term,x,y){
  const t=TERMS[term]; if(!t)return;
  const p=$("#termPop");
  p.innerHTML=`<h4>${term}</h4>
    <div class="tp"><b>SIMPLE DEFINITION</b>${t.d}</div>
    <div class="tp"><b>EXPLAIN LIKE I'M 5</b>${t.eli5}</div>
    <div class="tp" style="margin-bottom:0"><b>WHY IT MATTERS</b>${t.why}</div>`;
  p.style.display="block";
  const r=p.getBoundingClientRect();
  p.style.left=Math.min(Math.max(8,x-20),innerWidth-r.width-8)+"px";
  p.style.top=Math.min(Math.max(8,y+14),innerHeight-r.height-8)+"px";
}
function hideTermPop(){ $("#termPop").style.display="none"; }

/* ---------- GLOBAL CLICK DELEGATION ---------- */
document.addEventListener("click",e=>{
  const T=e.target;
  const g=sel=>T.closest(sel);
  let el;
  if(el=g("[data-go]")){ closeAllOv(); goTo(+el.dataset.go); return; }
  if(el=g("[data-go-map]")){ closeAllOv(); state.step=1; save(); renderCard(); window.scrollTo({top:0,behavior:"smooth"}); return; }
  if(el=g("[data-prev]")){ if(state.step>1) goTo(state.step-1); return; }
  if(el=g("[data-next]")){ state.completed[state.step]=true; save(); if(state.step<30) goTo(state.step+1); else { mode="learn"; renderCard(); } return; }
  if(el=g("[data-mode]")){ mode = mode===el.dataset.mode ? "learn" : el.dataset.mode; stopSpeech(); renderCard(); return; }
  if(el=g("[data-reveal]")){ const q=el.closest(".quizq,.mg"); if(q){const a=q.querySelector(".a"); if(a)a.style.display="block"; el.style.display="none";} return; }
  if(g("[data-gotit]")){ delete state.review[state.step]; state.completed[state.step]=true; save(); goTo(Math.min(30,state.step+1)); return; }
  if(g("[data-review]")){ state.review[state.step]=true; save(); renderCard(); return; }
  if(el=g("[data-hear]")){ toggleSpeech(); return; }
  if(el=g("[data-audio='pause']")){ if("speechSynthesis" in window){ speechSynthesis.paused?speechSynthesis.resume():speechSynthesis.pause(); } return; }
  if(g("[data-audio='stop']")){ stopSpeech(); const ab=$("#audiobar"); if(ab)ab.classList.remove("show"); return; }
  if(el=g("[data-speed]")){ rate=+el.dataset.speed; document.querySelectorAll(".speedbtn").forEach(b=>b.classList.toggle("on",b===el)); if("speechSynthesis" in window&&speechSynthesis.speaking){stopSpeech();speakCurrent();} return; }
  if(el=g("[data-term]")){ showTermPop(el.dataset.term.toLowerCase(), e.clientX, e.clientY); return; }
  if(el=g("[data-close]")){ el.closest(".overlay").classList.remove("show"); hideTermPop(); return; }
  if(!g("#termPop")&&!g(".term")) hideTermPop();
});
document.addEventListener("keydown",e=>{
  if(e.target.tagName==="INPUT"){ if(e.key==="Escape"){closeAllOv(); e.target.blur(); } return; }
  switch(e.key){
    case "ArrowLeft": goTo(state.step-1); break;
    case "ArrowRight": goTo(state.step+1); break;
    case " ": e.preventDefault(); toggleSpeech(); break;
    case "r": case "R": { const b=document.querySelector("[data-reveal]"); if(b)b.click(); break; }
    case "q": case "Q": mode = mode==="quiz"?"learn":"quiz"; renderCard(); break;
    case "m": case "M": mode = mode==="memory"?"learn":"memory"; renderCard(); break;
    case "?": closeAllOv(); showOv("#keysov"); break;
    case "/": e.preventDefault(); closeAllOv(); showOv("#searchov"); setTimeout(()=>$("#searchinput").focus(),50); break;
    case "Escape": closeAllOv(); break;
  }
});

/* NN tooltip */
document.addEventListener("mouseover",e=>{
  const el=e.target.closest("[data-nn]");
  const tip=$("#nntip");
  if(el){ tip.innerHTML=`<div class="tt">INSPECT</div>${el.dataset.nn}`; tip.style.display="block";
    const r=el.getBoundingClientRect(); tip.style.left=Math.min(innerWidth-270,r.left)+"px"; tip.style.top=(r.bottom+8)+"px";
  } else if(!e.target.closest("#nntip")) tip.style.display="none";
});

/* header buttons */
$("#btnSearch").onclick=()=>{closeAllOv();showOv("#searchov");setTimeout(()=>$("#searchinput").focus(),50);};
$("#btnKeys").onclick=()=>{closeAllOv();showOv("#keysov");};
$("#btnMap").onclick=()=>{renderMemMap();closeAllOv();showOv("#memmap");};
$("#btnSound").onclick=function(){ state.sound=!state.sound; save(); this.classList.toggle("on",state.sound); if(!state.sound)stopSpeech(); };
$("#btnTheme").onclick=()=>{ const h=document.documentElement; h.dataset.theme = h.dataset.theme==="dark"?"light":"dark"; };
$("#btnReset").onclick=()=>{ if(confirm("Reset all progress? This clears completed steps, quiz status, and your current position.")){ state={step:1,completed:{},review:{},sound:state.sound}; save(); mode="learn"; renderCard(); renderMemMap(); } };
$("#searchinput").addEventListener("input",e=>doSearch(e.target.value));
$("#btnStart").onclick=()=>{ hideOv("#welcome"); goTo(state.step); };

/* shortcuts content */
$("#scutsbody").innerHTML = [
  ["←","Previous step"],["→","Next step"],["Space","Play / pause explanation"],
  ["R","Reveal answer"],["Q","Quiz mode"],["M","Memory mode"],["/","Search"],["Esc","Close popover / modal"]
].map(c=>`<div class="scut"><kbd>${c[0]}</kbd>${c[1]}</div>`).join("");

/* keep the master map pinned right below the (possibly wrapped) header */
function fixMapOffset(){ document.getElementById("mapbar").style.top = document.querySelector("header").offsetHeight + "px"; }
addEventListener("resize", fixMapOffset);

/* ---------- INIT ---------- */
fixMapOffset();
buildNN(); buildChart(); buildLoop(); renderCard();
doSearch("");
if(Object.keys(state.completed).length>0 || state.step>1){
  const wc=$("#welCont"); wc.style.display="block";
  wc.textContent="Welcome back — you are on step "+state.step+" ("+Object.keys(state.completed).length+"/30 completed). Click start to continue.";
}
if(!state.sound) $("#btnSound").classList.remove("on");
</script>
</body>
